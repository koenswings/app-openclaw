# OpenClaw root compose environment
# Copy to .env and fill in real values. Never commit .env.

# Tailscale reusable auth key — used to auto-reconnect after container restarts.
# Generate at: https://login.tailscale.com/admin/settings/keys
# Settings: Reusable ✓  |  Pre-authorized ✓  |  Ephemeral ✗  |  Expiry: no expiry
TAILSCALE_AUTH_KEY=tskey-auth-REPLACE_ME
